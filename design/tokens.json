{
  "$schema": "./tokens.schema.md",
  "meta": {
    "name": "Transkrito",
    "version": 1,
    "direction": "quiet, minimal, fluid. Icy blue atmosphere, one central pillar visualization. One committed look; system dark mode is ignored.",
    "rule": "Every view pulls from these tokens. No literal color/size/duration values in views."
  },
  "color": {
    "bg": {
      "top": {
        "hex": "#D3E3F4",
        "use": "window gradient start (top)"
      },
      "bottom": {
        "hex": "#F2F6FB",
        "use": "window gradient end (bottom)"
      },
      "deep": {
        "hex": "#1E3F66",
        "alpha": 0.18,
        "use": "atmospheric radial wash behind the visualization; center (50%, 32%), fades to 0 at radius 55% of window width"
      }
    },
    "ink": {
      "primary": {
        "hex": "#24364D",
        "use": "transcript text, titles"
      },
      "secondary": {
        "hex": "#5B6E86",
        "use": "labels, timestamps, hints"
      },
      "tertiary": {
        "hex": "#8A9BB0",
        "use": "placeholders, disabled"
      },
      "inverse": {
        "hex": "#F4F8FC",
        "use": "text on accent button"
      }
    },
    "accent": {
      "base": {
        "hex": "#4A8BD6",
        "use": "primary action, active toggle, focus ring, links"
      },
      "soft": {
        "hex": "#9CC4EA",
        "use": "speaking pillar body"
      },
      "pale": {
        "hex": "#D6E6F7",
        "use": "idle pillar body, selection tint"
      }
    },
    "pillar": {
      "idle": {
        "ref": "ink.primary",
        "alpha": 0.1,
        "use": "non-speaking pillar fill"
      },
      "glassFillTop": {
        "hex": "#B9D7F3",
        "alpha": 0.78,
        "use": "speaking pillar gradient top"
      },
      "glassFillBottom": {
        "hex": "#8FBCE9",
        "alpha": 0.62,
        "use": "speaking pillar gradient bottom"
      },
      "glassHighlight": {
        "hex": "#FFFFFF",
        "alpha": 0.55,
        "width": 1,
        "coverage": 0.4,
        "use": "inner stroke, top 40% of pillar"
      },
      "glassEdge": {
        "hex": "#6FA6DF",
        "alpha": 0.35,
        "width": 0.5,
        "use": "outer refraction edge"
      }
    },
    "field": {
      "bg": {
        "hex": "#FFFFFF",
        "alpha": 0.5,
        "use": "search/text inputs"
      },
      "border": {
        "ref": "ink.primary",
        "alpha": 0.1
      }
    },
    "line": {
      "hairline": {
        "ref": "ink.primary",
        "alpha": 0.08,
        "use": "row separators"
      }
    },
    "state": {
      "danger": {
        "hex": "#C2544A",
        "use": "delete, mic/model errors"
      },
      "warning": {
        "hex": "#B7791F",
        "use": "dictionary 'looks common' warning"
      },
      "recording": {
        "ref": "accent.base",
        "use": "listening indicator (pulses)"
      }
    }
  },
  "type": {
    "family": {
      "mac": "system (SF Pro)",
      "windows": "Segoe UI Variable, Segoe UI",
      "mono": "system monospaced"
    },
    "caption": {
      "size": 11,
      "line": 14,
      "weight": 400,
      "tracking": 0,
      "use": "timestamps, hints, chips"
    },
    "body": {
      "size": 13,
      "line": 18,
      "weight": 400,
      "tracking": 0,
      "use": "rows, settings labels"
    },
    "transcript": {
      "size": 15,
      "line": 22,
      "weight": 400,
      "tracking": 0,
      "use": "transcription text"
    },
    "status": {
      "size": 15,
      "line": 20,
      "weight": 500,
      "tracking": 0.3,
      "use": "Ready / Listening / Transcribing"
    },
    "title": {
      "size": 20,
      "line": 26,
      "weight": 500,
      "tracking": -0.2,
      "use": "section/window titles"
    },
    "mono": {
      "size": 12,
      "line": 16,
      "weight": 400,
      "tracking": 0,
      "use": "hotkey glyphs"
    }
  },
  "space": {
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 24,
    "s6": 32,
    "s7": 48,
    "s8": 64,
    "rules": {
      "windowInset": "s6",
      "rowPaddingV": "s3",
      "rowPaddingH": "s4",
      "sectionGap": "s7"
    }
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "pill": 999
  },
  "border": {
    "hairline": {
      "width": 1,
      "color": "line.hairline"
    },
    "field": {
      "width": 1,
      "color": "field.border"
    },
    "focus": {
      "width": 1.5,
      "color": "accent.base",
      "alpha": 0.6
    },
    "warning": {
      "width": 1,
      "color": "state.warning",
      "alpha": 0.5
    }
  },
  "shadow": {
    "none": null,
    "menu": {
      "x": 0,
      "y": 2,
      "blur": 8,
      "color": "ink.primary",
      "alpha": 0.08,
      "use": "menus/popovers only"
    },
    "glow": {
      "x": 0,
      "y": 0,
      "blur": 14,
      "color": "accent.base",
      "alpha": 0.22,
      "use": "speaking pillars only; alpha scales with level"
    }
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "ease": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0.2,
        1
      ],
      "exit": [
        0.4,
        0,
        1,
        1
      ]
    },
    "level": {
      "attackMs": 60,
      "releaseMs": 220
    },
    "pillarSpring": {
      "response": 0.28,
      "damping": 0.85,
      "wpfLerpMs": 120
    },
    "statusPulse": {
      "periodMs": 1600,
      "opacityMin": 0.55,
      "opacityMax": 1.0
    }
  },
  "pillars": {
    "count": 21,
    "width": 6,
    "gap": 6,
    "minHeight": 8,
    "maxHeight": 120,
    "envelope": "cos^2(pi * d / (count-1)) where d = distance from center; floor 0.15",
    "jitter": 0.06,
    "speakingThreshold": 0.06,
    "idleLevel": 0.12,
    "idleWhy": "resting height so the envelope shape reads while silent"
  },
  "layout": {
    "window": {
      "minWidth": 560,
      "minHeight": 640,
      "defaultWidth": 640,
      "defaultHeight": 760
    },
    "settings": {
      "width": 460,
      "height": 360
    }
  },
  "bias": {
    "maxTerms": 40,
    "why": "long context makes speech models drift and invent text on quiet audio"
  },
  "component": {
    "fieldPaddingH": 10,
    "fieldPaddingV": 6,
    "pillHeight": 36,
    "checkSize": 16,
    "chipPaddingH": 8,
    "chipPaddingV": 2,
    "scrollbarWidth": 6,
    "pillarsAreaHeight": 160,
    "iconSize": 14,
    "why": "per-component sizes so views carry no literals",
    "pillMinWidth": 120,
    "tabGap": 24,
    "trayMenuMinWidth": 180
  }
}
