{
  "meta": {
    "name": "Transkrito",
    "version": 2,
    "direction": "A listening instrument, not a dashboard. Deep navy → icy cyan atmosphere; the glass capsule pillars are the only living thing; everything else is quiet navy paper with 1px glass edges. One committed dark look; the OS theme is ignored.",
    "source": "User-pinned 'Voice App Design System' board (2026-09-12) + Wispr Flow layout reference.",
    "rule": "Every view pulls from these tokens. No literal color/size/duration values in views. Run design/gen-tokens.py after editing."
  },
  "color": {
    "bg": {
      "top": {
        "hex": "#0B1E3D",
        "use": "window gradient start (top) — blue.900 Midnight"
      },
      "bottom": {
        "hex": "#050A14",
        "use": "window gradient end (bottom) — blue.950 Deep Navy"
      },
      "deep": {
        "hex": "#7DD3FC",
        "alpha": 0.14,
        "use": "icy wash behind the pillars; center (50%, 28%), fades to 0 at radius 55% of content width"
      },
      "rail": {
        "hex": "#050A14",
        "alpha": 0.55,
        "use": "sidebar rail fill over the gradient"
      }
    },
    "ink": {
      "primary": {
        "hex": "#F0F8FF",
        "alpha": 0.92,
        "use": "transcript text, titles — ice.100"
      },
      "secondary": {
        "hex": "#F0F8FF",
        "alpha": 0.64,
        "use": "labels, timestamps, hints"
      },
      "tertiary": {
        "hex": "#F0F8FF",
        "alpha": 0.4,
        "use": "placeholders, disabled, day headers"
      },
      "inverse": {
        "hex": "#F0F8FF",
        "use": "text on accent"
      }
    },
    "accent": {
      "base": {
        "hex": "#3B82F6",
        "use": "primary action, active nav, focus, links — blue.500 Sky"
      },
      "strong": {
        "hex": "#1C4ED8",
        "use": "pressed, pillar core — blue.700 Cobalt"
      },
      "ice": {
        "hex": "#7DD3FC",
        "use": "recording state, glow, highlights — ice.300"
      },
      "pale": {
        "hex": "#3B82F6",
        "alpha": 0.18,
        "use": "selection tint, chip fill, active nav fill"
      }
    },
    "surface": {
      "glass1": {
        "hex": "#F0F8FF",
        "alpha": 0.06,
        "use": "glass fill: fields, hovered rows, secondary buttons"
      },
      "glass2": {
        "hex": "#F0F8FF",
        "alpha": 0.1,
        "use": "glass fill: raised (popovers, pressed)"
      },
      "glass3": {
        "hex": "#F0F8FF",
        "alpha": 0.16,
        "use": "glass fill: strong (mic button rest)"
      }
    },
    "line": {
      "glass1": {
        "hex": "#F0F8FF",
        "alpha": 0.1,
        "use": "border.glass.1 — hairlines, field edges"
      },
      "glass2": {
        "hex": "#F0F8FF",
        "alpha": 0.2,
        "use": "border.glass.2 — hovered / raised edges"
      },
      "glassStrong": {
        "hex": "#F0F8FF",
        "alpha": 0.4,
        "use": "border.glass.strong — focused / active edges"
      }
    },
    "pillar": {
      "idle": {
        "hex": "#F0F8FF",
        "alpha": 0.18,
        "use": "resting pillar fill"
      },
      "glassFillTop": {
        "hex": "#7DD3FC",
        "alpha": 0.95,
        "use": "speaking pillar gradient top — ice"
      },
      "glassFillBottom": {
        "hex": "#1C4ED8",
        "alpha": 0.95,
        "use": "speaking pillar gradient bottom — cobalt"
      },
      "glassHighlight": {
        "hex": "#FFFFFF",
        "alpha": 0.7,
        "width": 1.5,
        "coverage": 0.4,
        "use": "inner highlight stroke, top 40% of pillar, left edge"
      },
      "glassEdge": {
        "hex": "#7DD3FC",
        "alpha": 0.45,
        "width": 0.75,
        "use": "outer refraction edge"
      }
    },
    "field": {
      "bg": {
        "ref": "surface.glass1"
      },
      "border": {
        "ref": "line.glass1"
      }
    },
    "state": {
      "danger": {
        "hex": "#F87171",
        "use": "delete, errors"
      },
      "warning": {
        "hex": "#FBBF24",
        "use": "dictionary 'looks common' warning"
      },
      "recording": {
        "ref": "accent.ice",
        "use": "listening indicator"
      },
      "success": {
        "hex": "#7DD3FC",
        "use": "copied confirmation"
      }
    }
  },
  "type": {
    "family": {
      "mac": "system (SF Pro)",
      "windows": "Segoe UI Variable Text, Segoe UI",
      "mono": "Cascadia Mono, SF Mono"
    },
    "caption": {
      "size": 12,
      "line": 16,
      "weight": 400,
      "tracking": 0,
      "use": "timestamps, hints, chips, day headers (uppercase +0.6 tracking)"
    },
    "body": {
      "size": 13,
      "line": 18,
      "weight": 400,
      "tracking": 0,
      "use": "nav, rows, settings labels"
    },
    "transcript": {
      "size": 15,
      "line": 22,
      "weight": 400,
      "tracking": 0,
      "use": "transcription text"
    },
    "status": {
      "size": 14,
      "line": 20,
      "weight": 500,
      "tracking": 0.2,
      "use": "Ready / Listening / Transcribing"
    },
    "title": {
      "size": 28,
      "line": 34,
      "weight": 500,
      "tracking": -0.5,
      "use": "page titles — type.title.m"
    },
    "mono": {
      "size": 12,
      "line": 16,
      "weight": 500,
      "tracking": 0.4,
      "use": "hotkey glyphs"
    }
  },
  "space": {
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 24,
    "s6": 32,
    "s7": 48,
    "s8": 64,
    "rules": {
      "pageInset": "s6",
      "rowPaddingV": "s3",
      "rowPaddingH": "s4",
      "sectionGap": "s6",
      "railInset": "s4"
    }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "border": {
    "hairline": {
      "width": 1,
      "color": "line.glass1"
    },
    "field": {
      "width": 1,
      "color": "line.glass1"
    },
    "raised": {
      "width": 1,
      "color": "line.glass2"
    },
    "focus": {
      "width": 1.5,
      "color": "accent.base",
      "alpha": 0.7
    },
    "warning": {
      "width": 1,
      "color": "state.warning",
      "alpha": 0.6
    }
  },
  "shadow": {
    "none": null,
    "menu": {
      "x": 0,
      "y": 4,
      "blur": 12,
      "color": "bg.bottom",
      "alpha": 0.45,
      "use": "shadow.soft.2 — menus, popovers"
    },
    "soft": {
      "x": 0,
      "y": 1,
      "blur": 2,
      "color": "bg.bottom",
      "alpha": 0.3,
      "use": "shadow.soft.1 — subtle elevation (mic button)"
    },
    "glow": {
      "x": 0,
      "y": 0,
      "blur": 24,
      "color": "accent.ice",
      "alpha": 0.45,
      "use": "speaking pillars + recording mic; alpha scales with level"
    }
  },
  "motion": {
    "fast": 150,
    "base": 200,
    "slow": 300,
    "ease": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0.2,
        1
      ],
      "exit": [
        0.4,
        0,
        1,
        1
      ]
    },
    "level": {
      "attackMs": 60,
      "releaseMs": 220
    },
    "pillarSpring": {
      "response": 0.3,
      "damping": 0.85,
      "wpfLerpMs": 120,
      "note": "motion.spring.gentle 300 ms"
    },
    "statusPulse": {
      "periodMs": 1600,
      "opacityMin": 0.55,
      "opacityMax": 1.0
    },
    "breathing": {
      "periodMs": 3000,
      "amplitude": 0.05,
      "note": "motion.breathing.idle — pillars at rest"
    },
    "rowHighlight": {
      "holdMs": 1600,
      "note": "new history row stays tinted until noticed"
    }
  },
  "pillars": {
    "count": 21,
    "width": 8,
    "gap": 7,
    "minHeight": 12,
    "maxHeight": 140,
    "envelope": "cos^2(pi * d / (count-1)) where d = distance from center; floor 0.15",
    "jitter": 0.06,
    "speakingThreshold": 0.06,
    "idleLevel": 0.3,
    "idleWhy": "resting height so the envelope shape reads while silent"
  },
  "layout": {
    "window": {
      "minWidth": 880,
      "minHeight": 600,
      "defaultWidth": 1040,
      "defaultHeight": 720
    },
    "settings": {
      "width": 560,
      "height": 520
    },
    "rail": {
      "width": 220
    },
    "content": {
      "maxWidth": 760
    }
  },
  "component": {
    "fieldPaddingH": 12,
    "fieldPaddingV": 8,
    "pillHeight": 36,
    "pillMinWidth": 120,
    "checkSize": 16,
    "chipPaddingH": 8,
    "chipPaddingV": 2,
    "scrollbarWidth": 6,
    "pillarsAreaHeight": 180,
    "iconSize": 16,
    "tabGap": 24,
    "trayMenuMinWidth": 180,
    "settingsLabelWidth": 140,
    "navItemHeight": 36,
    "micButton": 48,
    "railIconGap": 10,
    "why": "per-component sizes so views carry no literals",
    "iconSizeLg": 20,
    "iconSizeMd": 14,
    "iconSizeSm": 12,
    "iconStroke": 1.75,
    "popupMaxHeight": 280,
    "checkRadius": 4,
    "tickSize": 11,
    "timeColumn": 56,
    "timeBaselineOffset": 3,
    "rowGap": 2,
    "statusDot": 8,
    "dayHeaderTracking": 0.6
  },
  "bias": {
    "maxTerms": 40,
    "why": "long context makes speech models drift and invent text on quiet audio"
  }
}
