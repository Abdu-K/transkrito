<UserControl x:Class="Transkrito.Views.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Transkrito.Design"
             xmlns:v="clr-namespace:Transkrito.Views">
    <UserControl.Resources>
        <!-- Small type toggle reused for the add form and inline edit -->
        <Style x:Key="Toggle.Small" TargetType="RadioButton" BasedOn="{StaticResource Toggle.Text}">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}" />
            <Setter Property="Padding" Value="{StaticResource Pad.S1}" />
        </Style>
        <DataTemplate x:Key="EntryEditor" DataType="{x:Type v:EntryRow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Toggle.Small}" Content="Word or phrase" IsChecked="{Binding IsTerm}" />
                    <RadioButton Style="{StaticResource Toggle.Small}" Content="Correction" IsChecked="{Binding IsCorrection}" Margin="{StaticResource Pad.Gap.S3}" />
                </StackPanel>
                <Grid Margin="{StaticResource Pad.Below.S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource Field}" Text="{Binding Hear, UpdateSourceTrigger=PropertyChanged}"
                             d:FieldHelper.Placeholder="{Binding HearPlaceholder}" KeyDown="OnEditorKey" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="&#x2192;" Foreground="{StaticResource Brush.InkTertiary}"
                               VerticalAlignment="Center" Margin="{StaticResource Pad.S2}"
                               Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{Binding Write, UpdateSourceTrigger=PropertyChanged}"
                             d:FieldHelper.Placeholder="Write" KeyDown="OnEditorKey"
                             Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="{StaticResource Pad.Below.S1}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Message}" Foreground="{StaticResource Brush.StateWarning}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.Below.S1}">
                    <Button Style="{StaticResource Button.Text.Accent}" Content="{Binding SaveLabel}" Click="OnSave" Tag="{Binding}" IsEnabled="{Binding CanSave}" />
                    <Button Style="{StaticResource Button.Text}" Content="Cancel" Click="OnCancel" Tag="{Binding}" Margin="{StaticResource Pad.Gap.S3}"
                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInverse}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Add -->
        <ContentControl Grid.Row="0" x:Name="AddForm" ContentTemplate="{StaticResource EntryEditor}" Margin="{StaticResource Pad.S1}" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.Below.S3}">
            <TextBox x:Name="SearchBox" Style="{StaticResource Field}" d:FieldHelper.Placeholder="Search dictionary" TextChanged="OnSearchChanged" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.StateDanger}" Margin="{StaticResource Pad.Below.S1}"
                       Text="{Binding Dictionary.LoadError}" Visibility="{Binding Dictionary.LoadError, Converter={StaticResource NotEmptyToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Pad.Below.S2}">
            <Grid>
                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.InkTertiary}" HorizontalAlignment="Center"
                           Margin="{StaticResource Pad.S6}" Text="{Binding EmptyMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Visibility="{Binding IsEmpty, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type v:EntryRow}">
                            <StackPanel>
                                <Grid x:Name="Row" Background="Transparent" Margin="{StaticResource Pad.RowV}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Read mode -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Hear}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="&#x2192;" Foreground="{StaticResource Brush.InkTertiary}" Margin="{StaticResource Pad.S2}"
                                                   VerticalAlignment="Center" Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Write}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <!-- Edit mode -->
                                    <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource EntryEditor}"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Grid.Column="1" x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}">
                                        <Button Style="{StaticResource Button.Text}" Content="Edit" Click="OnEdit" Tag="{Binding}" />
                                        <Button Style="{StaticResource Button.Text.Danger}" Content="Delete" Click="OnDelete" Tag="{Binding}" Margin="{StaticResource Pad.Gap.S2}" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource Hairline}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
