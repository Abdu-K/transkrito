<Window x:Class="Transkrito.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:Transkrito.Design"
        Title="Settings"
        Width="{StaticResource Layout.Settings.Width}" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.BgBottom}" FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.InkSecondary}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="{StaticResource Pad.Field}" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="{StaticResource Pad.S6}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hotkey -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Hotkey" />
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" IsReadOnly="True" Cursor="Hand"
                         d:FieldHelper.Placeholder="Click, then press a combination" PreviewKeyDown="OnHotkeyKey"
                         GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Text.Caption}" Margin="{StaticResource Pad.Below.S1}"
                           Text="Press to start listening, press again to stop. Esc cancels." />
            </StackPanel>

            <!-- Model -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Model" Margin="{StaticResource Pad.Below.S5}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="{StaticResource Pad.Below.S5}">
                <ComboBox x:Name="ModelBox" Style="{StaticResource Combo}" SelectionChanged="OnModelChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Language}" Margin="{StaticResource Pad.Gap.S2}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.Below.S2}">
                    <TextBlock x:Name="ModelStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <Button x:Name="DownloadButton" Style="{StaticResource Button.Text.Accent}" Content="Download" Click="OnDownload" Margin="{StaticResource Pad.Gap.S3}" />
                    <Button x:Name="CancelButton" Style="{StaticResource Button.Text}" Content="Cancel" Click="OnCancelDownload" Margin="{StaticResource Pad.Gap.S3}" Visibility="Collapsed" />
                    <Button x:Name="RemoveButton" Style="{StaticResource Button.Text.Danger}" Content="Remove" Click="OnRemoveModel" Margin="{StaticResource Pad.Gap.S3}" Visibility="Collapsed" />
                </StackPanel>
                <Rectangle x:Name="Progress" Height="{StaticResource Border.Focus.Width}" Fill="{StaticResource Brush.AccentBase}" HorizontalAlignment="Left" Width="0"
                           Margin="{StaticResource Pad.Below.S1}" />
                <TextBlock x:Name="BiasStatus" Style="{StaticResource Text.Caption}" Margin="{StaticResource Pad.Below.S2}" />
            </StackPanel>

            <!-- Insert -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="After transcribing" Margin="{StaticResource Pad.Below.S5}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="{StaticResource Pad.Below.S5}">
                <CheckBox x:Name="InsertBox" Style="{StaticResource Check}" Content="Insert at cursor in the app I was using" Checked="OnInsertChanged" Unchecked="OnInsertChanged" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Pad.Below.S1}" Text="Text is always copied to the clipboard." />
            </StackPanel>

            <!-- Files -->
            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Files" Margin="{StaticResource Pad.Below.S5}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="{StaticResource Pad.Below.S5}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="Dictionary, history and settings are plain JSON you can edit by hand." />
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.Below.S1}">
                    <Button Style="{StaticResource Button.Text.Accent}" Content="Open folder" Click="OnOpenFolder" />
                    <TextBlock x:Name="DataPath" Style="{StaticResource Text.Mono}" Margin="{StaticResource Pad.Gap.S3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
