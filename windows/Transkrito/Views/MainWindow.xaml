<Window x:Class="Transkrito.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Transkrito.Views"
        Title="Transkrito"
        Width="{StaticResource Layout.Window.DefaultWidth}" Height="{StaticResource Layout.Window.DefaultHeight}"
        MinWidth="{StaticResource Layout.Window.MinWidth}" MinHeight="{StaticResource Layout.Window.MinHeight}"
        Background="{StaticResource Brush.BgGradient}"
        FontFamily="{StaticResource Font.Sans}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Window.InputBindings>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static v:MainWindow.OpenSettings}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static v:MainWindow.FocusSearch}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static v:MainWindow.GoDictation}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static v:MainWindow.GoDictionary}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static v:MainWindow.OpenSettings}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Layout.Rail.Width.Length}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Border Grid.Column="0" Background="{StaticResource Brush.BgRail}" BorderBrush="{StaticResource Brush.LineGlass1}" BorderThickness="0,0,1,0">
            <DockPanel Margin="{StaticResource Pad.Rail}">
                <!-- Wordmark -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource Pad.Field}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Waveform}" Stroke="{StaticResource Brush.AccentIce}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="Transkrito" FontWeight="Medium" Margin="{StaticResource Pad.Gap.S2}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status at the bottom: what the app is doing + the hotkey, always visible -->
                <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource Pad.Field}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="{StaticResource Comp.StatusDot}" Height="{StaticResource Comp.StatusDot}" VerticalAlignment="Center" Fill="{StaticResource Brush.InkTertiary}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.StateRecording}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTranscribing}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.AccentBase}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.StateDanger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" Margin="{StaticResource Pad.Gap.S2}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.StateDanger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.StateRecording}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <v:HotkeyCaps Margin="{StaticResource Pad.Below.S2}" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Margin="{StaticResource Pad.Below.S5}">
                    <RadioButton x:Name="NavDictation" Style="{StaticResource Nav.Item}" Content="Dictation" Tag="{StaticResource Icon.Mic}" GroupName="Nav" IsChecked="True" Checked="OnNav" />
                    <RadioButton x:Name="NavDictionary" Style="{StaticResource Nav.Item}" Content="Dictionary" Tag="{StaticResource Icon.Book}" GroupName="Nav" Checked="OnNav" Margin="{StaticResource Pad.Below.S1}" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav.Item}" Content="Settings" Tag="{StaticResource Icon.Sliders}" GroupName="Nav" Checked="OnNav" Margin="{StaticResource Pad.Below.S1}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Rectangle IsHitTestVisible="False" Fill="{StaticResource Brush.BgDeepWash}" Visibility="{Binding IsChecked, ElementName=NavDictation, Converter={StaticResource BoolToVis}}" />
            <v:DictationPage x:Name="PageDictation" />
            <v:DictionaryPage x:Name="PageDictionary" Visibility="Collapsed" />
            <v:SettingsPage x:Name="PageSettings" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
