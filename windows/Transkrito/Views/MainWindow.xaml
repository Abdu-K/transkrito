<Window x:Class="Transkrito.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Transkrito.Views"
        Title="Transkrito"
        Width="{StaticResource Layout.Window.DefaultWidth}" Height="{StaticResource Layout.Window.DefaultHeight}"
        MinWidth="{StaticResource Layout.Window.MinWidth}" MinHeight="{StaticResource Layout.Window.MinHeight}"
        Background="{StaticResource Brush.BgGradient}"
        FontFamily="{StaticResource Font.Sans}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Window.InputBindings>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static v:MainWindow.OpenSettings}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static v:MainWindow.FocusSearch}" />
    </Window.InputBindings>
    <Grid>
        <!-- Atmosphere: deep blue wash behind the visualization, fading out. Token bg.deep. -->
        <Rectangle IsHitTestVisible="False" Fill="{StaticResource Brush.BgDeepWash}" />

        <Grid Margin="{StaticResource Pad.S6}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status -->
            <TextBlock x:Name="StatusText" Grid.Row="0" Text="{Binding Status}" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Status}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.StateDanger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.StateRecording}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="{StaticResource Motion.StatusPulse.Max}" To="{StaticResource Motion.StatusPulse.Min}"
                                                             Duration="{StaticResource Motion.StatusPulse}">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Visualization -->
            <v:PillarsControl Grid.Row="1" Height="{StaticResource Comp.PillarsAreaHeight}" Margin="{StaticResource Pad.S4}"
                              HorizontalAlignment="Center" Level="{Binding Level}" />

            <!-- Start / Stop + hotkey hint -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Vertical">
                <Button Style="{StaticResource Button.Pill}" Content="{Binding ActionLabel}" Click="OnToggle" MinWidth="{StaticResource Comp.PillMinWidth}" HorizontalAlignment="Center"
                        IsEnabled="{Binding IsTranscribing, Converter={StaticResource InverseBool}}" />
                <TextBlock Text="{Binding HotkeyLabel}" HorizontalAlignment="Center" Margin="{StaticResource Pad.S2}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyHasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.StateDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- History | Dictionary -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource Pad.Tabs}">
                <RadioButton x:Name="TabHistory" Style="{StaticResource Toggle.Text}" Content="History" IsChecked="True" GroupName="Tab" Checked="OnTabChanged" />
                <RadioButton x:Name="TabDictionary" Style="{StaticResource Toggle.Text}" Content="Dictionary" GroupName="Tab" Margin="{StaticResource Pad.TabGap}" Checked="OnTabChanged" />
            </StackPanel>

            <Grid Grid.Row="4">
                <v:HistoryView x:Name="HistoryPane" />
                <v:DictionaryView x:Name="DictionaryPane" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Quiet footer: settings link -->
        <Button Style="{StaticResource Button.Text}" Content="Settings" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="{StaticResource Pad.S3}" Command="{x:Static v:MainWindow.OpenSettings}" />
    </Grid>
</Window>
