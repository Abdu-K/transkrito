<UserControl x:Class="Transkrito.Views.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Transkrito.Design"
             xmlns:v="clr-namespace:Transkrito.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="EntryEditor" DataType="{x:Type v:EntryRow}">
            <StackPanel>
                <Border Style="{StaticResource Segmented}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Toggle.Segment}" Content="Word or phrase" IsChecked="{Binding IsTerm}" />
                        <RadioButton Style="{StaticResource Toggle.Segment}" Content="Correction" IsChecked="{Binding IsCorrection}" />
                    </StackPanel>
                </Border>
                <Grid Margin="{StaticResource Pad.Below.S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding IsCorrection, Converter={StaticResource BoolToStar}}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource Field}" Text="{Binding Hear, UpdateSourceTrigger=PropertyChanged}"
                             d:FieldHelper.Placeholder="{Binding HearPlaceholder}" KeyDown="OnEditorKey" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="&#x2192;" Foreground="{StaticResource Brush.InkTertiary}"
                               VerticalAlignment="Center" Margin="{StaticResource Pad.S2}"
                               Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{Binding Write, UpdateSourceTrigger=PropertyChanged}"
                             d:FieldHelper.Placeholder="Write it as" KeyDown="OnEditorKey"
                             Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="{StaticResource Pad.Gap.S2}">
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding SaveLabel}" Click="OnSave" Tag="{Binding}" IsEnabled="{Binding CanSave}" />
                        <Button Style="{StaticResource Button.Glass}" Content="Cancel" Click="OnCancel" Tag="{Binding}" Margin="{StaticResource Pad.Gap.S2}"
                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInverse}}" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="{StaticResource Pad.Below.S2}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Message}" Foreground="{StaticResource Brush.StateWarning}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Pad.Page}" MaxWidth="{StaticResource Layout.Content.MaxWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Text.Title}" Text="Dictionary" />
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.InkSecondary}" Margin="{StaticResource Pad.Below.S1}"
                       Text="Teach it the words it gets wrong: names, jargon, products, people. Corrections also catch glued forms like CloudCode." />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.StateDanger}" Margin="{StaticResource Pad.Below.S1}"
                       Text="{Binding Dictionary.LoadError}" Visibility="{Binding Dictionary.LoadError, Converter={StaticResource NotEmptyToVis}}" />
        </StackPanel>

        <ContentControl Grid.Row="1" x:Name="AddForm" ContentTemplate="{StaticResource EntryEditor}" Margin="{StaticResource Pad.Below.S5}" />

        <Grid Grid.Row="2" Margin="{StaticResource Pad.Below.S5}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource Field}" d:FieldHelper.Placeholder="Search dictionary"
                     d:FieldHelper.Icon="{StaticResource Icon.Search}" TextChanged="OnFilterChanged" />
            <Border Grid.Column="1" Style="{StaticResource Segmented}" Margin="{StaticResource Pad.Gap.S3}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource Toggle.Segment}" Content="All" IsChecked="True" GroupName="Filter" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterWords" Style="{StaticResource Toggle.Segment}" Content="Words" GroupName="Filter" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterCorrections" Style="{StaticResource Toggle.Segment}" Content="Corrections" GroupName="Filter" Checked="OnFilterChanged" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Pad.Below.S3}">
            <Grid>
                <TextBlock x:Name="Empty" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.InkTertiary}" HorizontalAlignment="Center"
                           Margin="{StaticResource Pad.S7}" Text="{Binding EmptyMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type v:EntryRow}">
                            <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource Radius.Md}" Padding="{StaticResource Pad.Row}" Margin="{StaticResource Pad.RowGap}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Hear}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="&#x2192;" Foreground="{StaticResource Brush.InkTertiary}" Margin="{StaticResource Pad.S2}"
                                                   VerticalAlignment="Center" Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Write}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCorrection, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource EntryEditor}"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Grid.Column="1" x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}">
                                        <Button Style="{StaticResource Button.Icon}" Tag="{StaticResource Icon.Pencil}" ToolTip="Edit" Click="OnEdit" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon.Danger}" Tag="{StaticResource Icon.Trash}" ToolTip="Delete" Click="OnDelete" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceGlass1}" />
                                </Trigger>
                                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceGlass1}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
